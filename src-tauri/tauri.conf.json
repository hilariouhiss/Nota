{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nota",
  "version": "0.1.0",
  "identifier": "io.github.hilariouhiss.nota",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nota",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "backgroundColor": "#ffffff",
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
